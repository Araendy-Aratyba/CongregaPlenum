{
  "rubyLsp.rubyVersionManager": {
    "identifier": "rbenv"
  },
  "rubyLsp.formatter": "rubocop",
  "rubyLsp.pullDiagnosticsOn": "save",
  "ruby.rubocop.onSave": false,
  "solargraph.autoformat": false,
  "solargraph.completion": false,
  "solargraph.definitions": false,
  "solargraph.diagnostics": false,
  "solargraph.folding": false,
  "solargraph.formatting": false,
  "solargraph.hover": false,
  "solargraph.references": false,
  "solargraph.rename": false,
  "solargraph.symbols": false,
  "sorbet.enabled": false,
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.insertSpaces": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.tabSize": 2
  }
}
